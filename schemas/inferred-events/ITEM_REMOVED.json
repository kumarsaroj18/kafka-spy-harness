{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["action", "itemId", "reason"],
  "properties": {
    "action": { "type": "string", "const": "ITEM_REMOVED" },
    "itemId": { "type": "string" },
    "reason": { "type": "string", "enum": ["out-of-stock", "discontinued", "damaged", "recalled"] }
  }
}
