{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["cardNumber", "expiry", "cvv", "amount"],
  "properties": {
    "cardNumber": { "type": "string" },
    "expiry":     { "type": "string" },
    "cvv":        { "type": "string" },
    "amount":     { "type": "number", "minimum": 0 }
  }
}
